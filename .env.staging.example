# Solo para Render staging; no usar estos valores en producción.
NODE_ENV=staging
PIKI_ENVIRONMENT=staging
PIKI_ALLOW_TEST_ORDERS=true
PORT=3000
MONGODB_URI=<COPIAR_SECRETO_MONGODB_CON_BASE_AISLADA>
MONGODB_DB=piki_staging
PUBLIC_API_URL=https://piki-api-staging.onrender.com
# Los previews gestionados de PIKI en Vercel ya pasan la política CORS de la API.
# Añade aquí, separados por comas, solo dominios staging adicionales explícitos.
CORS_ORIGINS=

# Generar valores distintos de los de producción.
ADMIN_API_TOKEN=<SECRETO_STAGING>
PARTNER_API_TOKEN=<SECRETO_STAGING>
RIDER_API_TOKEN=<SECRETO_STAGING>
FLEET_API_TOKEN=<SECRETO_STAGING>
CHECKOUT_TOKEN_SECRET=<SECRETO_STAGING>
PICKUP_QR_SECRET=<SECRETO_STAGING>
DELIVERY_QR_SECRET=<SECRETO_STAGING>
PIKI_CUSTOMER_SYNC_SECRET=<SECRETO_STAGING>
GOOGLE_MAPS_API_KEY=<SECRETO_MAPS_RESTRINGIDO_A_STAGING>
