NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/piki?retryWrites=true&w=majority
MONGODB_DB=piki
# Debe coincidir exactamente con PIKI_CUSTOMER_SYNC_SECRET del proyecto piki-customer en Vercel.
PIKI_CUSTOMER_SYNC_SECRET=replace-with-a-long-random-token
GOOGLE_MAPS_API_KEY=replace-with-google-maps-server-key
# Fallback opcional si Google Maps no responde
ROUTING_OSRM_URL=https://router.project-osrm.org
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SEED_DEMO_DATA=false
ADMIN_API_TOKEN=replace-with-a-long-random-token
PARTNER_API_TOKEN=replace-with-a-long-random-token
PARTNER_API_RESTAURANT_ID=optional-scoped-restaurant-object-id-for-partner-api-token
RIDER_API_TOKEN=replace-with-a-long-random-token
FLEET_API_TOKEN=replace-with-a-long-random-token
# Solo para pruebas controladas: limita el token técnico a un único Rider de MongoDB.
RIDER_API_RIDER_ID=replace-with-rider-object-id
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_replace-me
SIGNATURIT_ACCESS_TOKEN=replace-with-signaturit-token
# Sandbox por defecto: https://api.sandbox.signaturit.com/v3
SIGNATURIT_API_BASE_URL=https://api.sandbox.signaturit.com/v3
SIGNATURIT_EVENTS_URL=https://api.pikidelivery.com/api/v1/signatures/signaturit/events
SIGNATURIT_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token

# Rider incentives remain off until finance/legal approve the campaign terms and global monthly cap.
PIKI_RIDER_REFERRALS_ENABLED=false
PIKI_HOURLY_GUARANTEE_ENABLED=false
PIKI_RIDER_INCENTIVES_MONTHLY_CAP_CENTS=0
PIKI_RIDER_INCENTIVES_START_AT=
PIKI_HOURLY_GUARANTEE_ZONE_SLUG=xativa-centro
