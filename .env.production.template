# Copy these keys into Render Environment, then replace every <REQUIRED_SECRET> value.
NODE_ENV=production
PORT=3000
MONGODB_URI=<REQUIRED_SECRET_MONGODB_ATLAS_URI>
MONGODB_DB=piki
PIKI_INLINE_DISPATCH_WORKER=false
PIKI_DISPATCH_WORKER_POLL_MS=1000
PIKI_DISPATCH_WORKER_BATCH_SIZE=25
PUBLIC_API_URL=https://api.pikidelivery.com
CORS_ORIGINS=https://pikidelivery.com,https://app.pikidelivery.com,https://admin.pikidelivery.com,https://riders.pikidelivery.com,https://partners.pikidelivery.com,https://fleet.pikidelivery.com
CUSTOMER_APP_URL=https://app.pikidelivery.com
PRL_COURSE_URL=https://pikidelivery.com/formacion-prl
# Mantener provider_pending hasta que el servicio de prevención autorizado esté integrado.
PRL_CERTIFICATE_MODE=provider_pending
PRL_CERTIFICATE_ISSUER=<OPTIONAL_LEGAL_PREVENTION_SERVICE_NAME>
PARTNER_APP_URL=https://partners.pikidelivery.com
PASSKEY_ORIGINS=https://app.pikidelivery.com,https://partners.pikidelivery.com
PASSKEY_RP_ID=app.pikidelivery.com
ADMIN_API_TOKEN=<REQUIRED_SECRET_LONG_RANDOM_TOKEN>
PARTNER_API_TOKEN=<REQUIRED_SECRET_LONG_RANDOM_TOKEN>
RIDER_API_TOKEN=<REQUIRED_SECRET_LONG_RANDOM_TOKEN>
FLEET_API_TOKEN=<REQUIRED_SECRET_LONG_RANDOM_TOKEN>
PICKUP_QR_SECRET=<REQUIRED_SECRET_LONG_RANDOM_TOKEN>
DELIVERY_QR_SECRET=<REQUIRED_SECRET_LONG_RANDOM_TOKEN>
WEB_PUSH_VAPID_PUBLIC_KEY=<REQUIRED_PUBLIC_VAPID_KEY>
WEB_PUSH_VAPID_PRIVATE_KEY=<REQUIRED_SECRET_VAPID_PRIVATE_KEY>
WEB_PUSH_VAPID_SUBJECT=mailto:rrhh.milchollos@gmail.com
WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY=<REQUIRED_SECRET_32_BYTE_KEY>
# Firebase service-account JSON for com.pikidelivery.customer. Set as a Render secret, never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=<REQUIRED_SECRET_FIREBASE_SERVICE_ACCOUNT_JSON>
STRIPE_SECRET_KEY=<REQUIRED_SECRET_STRIPE_LIVE_KEY>
STRIPE_WEBHOOK_SECRET=<REQUIRED_SECRET_STRIPE_WEBHOOK_SECRET>
STRIPE_IDENTITY_WEBHOOK_SECRET=<REQUIRED_SECRET_STRIPE_IDENTITY_WEBHOOK_SECRET>
GOOGLE_MAPS_API_KEY=<REQUIRED_SECRET_SERVER_MAPS_KEY>
GOOGLE_BUSINESS_CLIENT_ID=<REQUIRED_SECRET_GOOGLE_BUSINESS_CLIENT_ID>
GOOGLE_BUSINESS_CLIENT_SECRET=<REQUIRED_SECRET_GOOGLE_BUSINESS_CLIENT_SECRET>
GOOGLE_BUSINESS_REDIRECT_URI=https://api.pikidelivery.com/api/v1/partners/google-business/callback
GOOGLE_BUSINESS_TOKEN_ENCRYPTION_KEY=<REQUIRED_SECRET_LONG_RANDOM_KEY>
PARTNER_GOOGLE_SUCCESS_URL=https://partners.pikidelivery.com/?google=connected
PARTNER_GOOGLE_ERROR_URL=https://partners.pikidelivery.com/?google=error
SIGNATURIT_ACCESS_TOKEN=<OPTIONAL_SECRET>
SIGNATURIT_API_BASE_URL=https://api.sandbox.signaturit.com/v3
SIGNATURIT_EVENTS_URL=https://api.pikidelivery.com/api/v1/signatures/signaturit/events
SIGNATURIT_WEBHOOK_TOKEN=<OPTIONAL_SECRET_LONG_RANDOM_TOKEN>
SEED_DEMO_DATA=false
# Enable only for one controlled migration run, then remove both keys.
# ALLOW_TENANT_MIGRATION=true
# RUN_TENANT_MIGRATION=true
PIKI_ROOT_TENANT_SLUG=piki-platform
PIKI_ROOT_TENANT_NAME=PIKI Delivery
