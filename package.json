{
  "name": "piki-api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "migrate:tenants": "tsx scripts/migrate-tenants.ts",
    "dispatch:postgis": "node scripts/run-postgis-batch.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "@types/web-push": "^3.6.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "mongoose": "^8.18.0",
    "pg": "^8.23.0",
    "stripe": "^18.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/node": "^22.19.3",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
